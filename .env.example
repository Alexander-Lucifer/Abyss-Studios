# Email Configuration for Contact Forms
# Copy this file to .env and fill in your actual values

# SMTP Configuration (Optional - forms will fallback to mailto if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Contact Email (where to send form submissions)
CONTACT_EMAIL=contactus@abyssstudios.site

# How it works:
# 1. Forms first try to send via SMTP server (if configured)
# 2. If SMTP fails or not configured, forms fallback to mailto links
# 3. Mailto opens user's default email client with pre-filled content
# 4. User sends email from their own email address

# SMTP Setup (Optional):
# 1. For Gmail, use an App Password instead of your regular password
# 2. Enable 2-factor authentication on your Gmail account
# 3. Go to Google Account settings > Security > App passwords
# 4. Generate a new app password for "Mail" on "Other device"
# 5. Use that app password as SMTP_PASSWORD

# Alternative SMTP providers:
# - Outlook: smtp-mail.outlook.com:587
# - SendGrid: smtp.sendgrid.net:587
# - Mailgun: smtp.mailgun.org:587

# No SMTP? Forms will still work via mailto fallback!
